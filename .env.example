# Copy to `.env` and fill in the key for the provider you choose.

# openai | gemini | openrouter | litellm
LLM_PROVIDER=openai
LLM_TEMPERATURE=0

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# LiteLLM (LLM_PROVIDER=litellm): any model string LiteLLM supports,
# e.g. anthropic/claude-sonnet-4-5, ollama/llama3, azure/<deployment>.
# API key and base URL are optional (needed for most hosted/self-hosted endpoints).
LITELLM_MODEL=
LITELLM_API_KEY=
LITELLM_API_BASE=

# Uploads
MAX_UPLOAD_MB=200
MAX_FILES_PER_UPLOAD=10

# Analysis
MAX_CODE_RETRIES=3

# Follow-up suggestions: how many to show, and whether to ask the LLM for result-specific ones
# (profile-based suggestions are always generated; every suggestion is validated against your columns)
FOLLOW_UP_COUNT=3
FOLLOW_UP_LLM_ENABLED=true
SANDBOX_TIMEOUT_SECONDS=60
SANDBOX_MEMORY_MB=4096
